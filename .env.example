# Le serveur ne lit pas ce fichier tout seul (zero dependance) : definir ces variables dans l'environnement.
PORT=3000
# Compte administrateur cree au premier demarrage (sinon : compte de demonstration admin / HandiDiag-Demo-2026,
# ou, avec NODE_ENV=production, un mot de passe aleatoire affiche une seule fois dans la console).
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-avec-un-mot-de-passe-solide
# Seuil d'affichage des compteurs (valeurs inferieures masquees)
MIN_COUNT=5
# Evenements anonymes acceptes par minute et par adresse (large : a l'ecole, tous les etudiants partagent la meme adresse)
EVENT_RATE_LIMIT=600
# Derriere un reverse-proxy : utiliser X-Forwarded-For pour distinguer les visiteurs
# TRUST_PROXY=1
# Aucune statistique, aucun espace administrateur
# DISABLE_STATS=1
# Jeton API facultatif (automatisation / export par script), en plus des comptes
# ADMIN_TOKEN=
# Emplacements facultatifs : STATS_FILE=/data/stats.json  ADMIN_FILE=/data/admin.json

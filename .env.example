# Copier ce fichier en .env puis adapter les valeurs.
# development (par défaut) ou production (cookies sécurisés, pas de documentation d'API, pas de données de démonstration)
ENVIRONMENT=development
# Port local du site (http://localhost:8080)
PORT=8080
POSTGRES_PASSWORD=handidiag
# Premier compte administrateur, créé si la base n'en contient aucun.
# Sans mot de passe, un mot de passe provisoire est généré et affiché dans : docker compose logs api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# true : aucune statistique n'est collectée
DISABLE_STATS=false
